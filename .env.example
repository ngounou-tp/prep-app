# Copy this file to .env.local and fill in real values. Never commit .env.local.
TAVILY_API_KEY=your-tavily-api-key
BIFROST_URL=http://localhost:8080

# auto (the default when blank): ask Bifrost which chat models its providers offer, use the
# first and up to three others as fallbacks. Or name one model as provider/model.
BIFROST_MODEL=auto

# A Bifrost virtual key (it starts with sk-bf-), sent in the x-bf-vk header. Create one in the
# Bifrost dashboard under Virtual Keys. Not a provider key: a Groq or OpenAI key does not go here.
# Needed when Bifrost enforces virtual keys on inference, which new deployments do by default.
BIFROST_API_KEY=

# Optional. Comma-separated provider/model ids Bifrost tries if the main model fails, or auto
# to take them from the available models. Blank with BIFROST_MODEL=auto also means auto.
# Example: BIFROST_FALLBACK_MODELS=provider-a/model-one,provider-b/model-two
BIFROST_FALLBACK_MODELS=

# Optional. Model calls running at once (1 to 6) and the pause between calls in
# milliseconds. Keep 1 and 1000 on free tiers to stay under rate limits.
LLM_CONCURRENCY=1
LLM_PAUSE_MS=1000

# Optional. Sources kept per subject (1 to 12) and characters kept per source (200 to 1500).
MAX_SOURCES_PER_SUBJECT=8
SOURCE_CHARS=800

# Optional, development only. 1 makes createBriefing return fixtures/sample-briefing.json
# with no network calls. Ignored in production.
USE_FIXTURE=
